# ============================================================
#  خرازی پرنسا — قواعد نادیده‌گرفتن گیت
# ------------------------------------------------------------
#  این فایل در مرحله ۳ اضافه شد. پیش از این، پروژه هیچ
#  `.gitignore` نداشت و در نتیجه فایل `.env` (شامل APP_KEY و
#  چند کلید سرویس پیامک/پرداخت) در گیت ثبت شده بود. ثبت `.env`
#  یعنی هر بار push، رمزها به مخزن راه پیدا می‌کنند.
#
#  توجه: این قواعد فقط روی فایل‌های «ثبت‌نشده» اثر دارند. فایل‌هایی
#  که از قبل در گیت ثبت شده‌اند (مثل vendor/) تا زمانی که با
#  `git rm --cached` از رهگیری خارج نشوند، همچنان رهگیری می‌شوند.
# ============================================================

# ── ۱) متغیرهای محیطی و رمزها ───────────────────────────────
.env
.env.backup
.env.old
.env.*.local
*.pem
*.key
*.p12
*.pfx

# ── ۲) وابستگی‌ها و خروجی ساخت ──────────────────────────────
/vendor
/node_modules
/public/hot
/public/mix-manifest.json
/public/js/vendor
/public/css/vendor

# ── ۳) فایل‌های موقت و لاگ ──────────────────────────────────
/storage/logs/*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/app/public/*
!/storage/app/public/.gitkeep
*.log
npm-debug.log*
yarn-error.log

# ── ۴) ویرایشگر و سیستم‌عامل ────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

# ── ۵) پشتیبان‌های محلی ─────────────────────────────────────
#  توجه: `database/peransa-db.sql` عمداً نادیده گرفته نشده است؛
#  آن فایل بخشی از خروجی تحویلی پروژه است.
/backups
*.sql.bak
*.sql.gz
*.tar.gz
